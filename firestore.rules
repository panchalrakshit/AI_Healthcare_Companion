rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }
    function admin() {
      return active()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function patient() {
      return active()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient';
    }
    function assignedDoctor(data) {
      return active()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor'
        && (data.doctorId == request.auth.uid
          || get(/databases/$(database)/documents/doctors/$(data.doctorId)).data.get('uid', '') == request.auth.uid);
    }
    match /users/{userId} {
      // Self-read remains available to explain suspended/missing-profile login errors.
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if admin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'status', 'createdAt'])
        && !exists(/databases/$(database)/documents/adminDeletedUsers/$(userId))
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'patient'
        && request.resource.data.status == 'active');
      // Role, status and identity are privileged fields. Clients cannot promote themselves.
      allow update: if admin() || (active() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photoURL', 'updatedAt']));
      allow delete: if admin();
    }
    match /doctors/{doctorId} {
      allow read: if active();
      allow write: if admin();
    }
    match /healthProfiles/{userId} {
      allow read, write: if admin() || (active() && request.auth.uid == userId);
    }
    match /healthRecords/{recordId} {
      allow create: if admin() || (patient() && request.resource.data.patientId == request.auth.uid);
      allow read, delete: if admin() || (active() && resource.data.patientId == request.auth.uid);
      allow update: if admin() || (active() && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == request.auth.uid);
    }
    match /appointments/{appointmentId} {
      allow create: if admin() || (patient()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)).data.get('status', 'active') == 'active');
      allow read: if admin() || (active() && resource.data.patientId == request.auth.uid) || assignedDoctor(resource.data);
      allow update: if admin() || (
        active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && ((resource.data.patientId == request.auth.uid && request.resource.data.status == 'cancelled')
          || (assignedDoctor(resource.data) && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled'])));
      allow delete: if admin() || (active() && resource.data.patientId == request.auth.uid);
    }
    match /adminDeletedUsers/{userId} {
      allow read, create, update: if admin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
